#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n = 5, i;
    int *a = malloc(n * sizeof(int));
    int *b = calloc(n, sizeof(int));

    if (a == NULL || b == NULL) {
        printf("Memory allocation failed.\n");
        free(a);
        free(b);
        return 1;
    }

    for (i = 0; i < n; i++) {
        a[i] = (i + 1) * 10;
    }

    printf("Values stored using malloc: ");
    for (i = 0; i < n; i++) printf("%d ", a[i]);

    printf("\nValues initialized by calloc: ");
    for (i = 0; i < n; i++) printf("%d ", b[i]);

    free(a);
    free(b);
    printf("\nMemory released using free().\n");
    return 0;
}

output:

Values stored using malloc: 10 20 30 40 50
Values initialized by calloc: 0 0 0 0 0
Memory released using free().

