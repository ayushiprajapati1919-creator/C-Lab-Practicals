#include <stdio.h>
#define MAX 100

int main(void) {
    int a[MAX] = {10, 20, 30, 40}, n = 4;
    int choice, value, pos, i, found;

    do {
        printf("\n1.Insert  2.Delete  3.Search  4.Display  0.Exit\nChoice: ");
        if (scanf("%d", &choice) != 1) return 0;

        switch (choice) {
            case 1:
                if (n == MAX) { printf("Array is full.\n"); break; }
                printf("Enter position (1-%d) and value: ", n + 1);
                scanf("%d%d", &pos, &value);
                if (pos < 1 || pos > n + 1) { printf("Invalid position.\n"); break; }
                for (i = n; i >= pos; i--) a[i] = a[i - 1];
                a[pos - 1] = value; n++;
                printf("Inserted.\n");
                break;
            case 2:
                printf("Enter position to delete (1-%d): ", n);
                scanf("%d", &pos);
                if (pos < 1 || pos > n) { printf("Invalid position.\n"); break; }
                value = a[pos - 1];
                for (i = pos - 1; i < n - 1; i++) a[i] = a[i + 1];
                n--;
                printf("Deleted %d.\n", value);
                break;
            case 3:
                printf("Enter value to search: ");
                scanf("%d", &value);
                found = -1;
                for (i = 0; i < n; i++) if (a[i] == value) { found = i; break; }
                if (found >= 0) printf("Found at position %d.\n", found + 1);
                else printf("Not found.\n");
                break;
            case 4:
                printf("Array: ");
                for (i = 0; i < n; i++) printf("%d ", a[i]);
                printf("\n");
                break;
            case 0: break;
            default: printf("Invalid choice.\n");
        }
    } while (choice != 0);
    return 0;
}


